// ════════════════════════════════════════════════════════════════
// 🚨 DB 안전 잠금장치 (Database Data-Loss Protection Lock)
//
// 1. 본 DB는 상용 현장 데이터(노무, 장비, 자재, 경비, 기성)와 직결되어 있습니다.
// 2. 컬럼 삭제/모델 삭제/타입 변경 등 데이터 유실을 유발하는 파괴적 변경은 엄격히 금지됩니다.
// 3. 신규 필드는 반드시 Optional(? 또는 @default)로만 추가해야 무손실 안전 배포가 보장됩니다.
// 4. 빌드 스크립트(scripts/db-sync.js)는 --accept-data-loss를 허용하지 않으며 파괴적 변경 시 즉시 차단합니다.
// ════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  // native: 로컬 개발용 / debian-openssl-3.0.x: 기존 Docker(시놀로지) 배포용
  // rhel-openssl-3.0.x: Vercel 서버리스 함수(Amazon Linux) 배포에 필수
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String     @unique
  pin       String     @default("") // Legacy PIN storage; kept only for migration compatibility
  pinHash   String     @default("")
  role      String     @default("WORKER") // ADMIN, WORKER
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  siteAccess UserSite[] // WORKER의 현장 접근 권한 (ADMIN은 이 목록과 무관하게 전체 접근)
}

// 사용자-현장 접근 권한 매핑 (다중 현장 운영 시 WORKER가 자신의 현장에만 접근하도록 제한)
model UserSite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([siteId])
}

// 근로자(인적사항 + 등록 얼굴) — 신원확인/출퇴근용
model Worker {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  company        String?      // 소속 업체
  jobType        String?      // 직종/공종
  birthDate      DateTime?    // 생년월일
  birthYYMMDD     String?      // Drive 마스터/서류 인식용 생년월일 6자리
  gender         String?      // 성별
  safetyEduDate  DateTime?    // 안전교육 이수일
  safetyEduNumber String?      // 기초안전보건교육 이수번호
  basicSafetyEdu Boolean      @default(false) // 기초안전보건교육 이수
  bankName       String?
  accountNumber  String?
  documentStatus String       @default("UNKNOWN") // UNKNOWN/INCOMPLETE/COMPLETE/REVIEW
  driveFolderUrl String?
  photoUrl       String?      // 등록 기준 얼굴 사진
  faceDescriptor Json?        // 얼굴 특징벡터(128차원)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attendances    Attendance[]
  documents      WorkerDocument[]
  labors         Labor[]
}

// 출퇴근 기록 (하루 1행 / 근로자)
model Attendance {
  id               String    @id @default(cuid())
  workerId         String
  worker           Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId           String?
  siteName         String?
  date             DateTime  // 근무일

  checkInAt        DateTime?
  checkInPhotoUrl  String?
  checkInLat       Float?
  checkInLng       Float?
  checkInScore     Float?    // 얼굴 유사도 0~1

  checkOutAt       DateTime?
  checkOutPhotoUrl String?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutScore    Float?

  workMinutes      Int?      // 근무시간(분)
  verifyStatus     String    @default("REVIEW") // AUTO/REVIEW/CONFIRMED/REJECTED
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workerId, date])
}

model Site {
  id             String      @id @default(cuid())
  name           String
  location       String?
  contractAmount Float       @default(0) // 도급액 (견적내역서 총액, 절사 등 조정 포함)
  startDate      DateTime    @default(now()) // 공사 시작일
  endDate        DateTime    @default(now()) // 공사 종료일
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  logs           DailyLog[]
  monthlyBillings MonthlyBilling[]
  contractItems       ContractItem[]
  monthlyClaims       MonthlyProgressClaim[]
  billingAdjustments  BillingAdjustment[]
  userAccess          UserSite[]
}

model DailyLog {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  weather     String?
  description String?  // 오늘의 작업내용
  
  labors      Labor[]
  equipments  Equipment[]
  materials   Material[]
  expenses    Expense[]
  outsourcings Outsourcing[]
  photos      Photo[]
  workQuantities WorkQuantity[] // 오늘 시공한 계약품목별 수량 (기성 산정 기초자료)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, siteId])
}

model Photo {
  id        String   @id @default(cuid())
  logId     String
  log       DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  url       String
  createdBy String?
  createdAt DateTime @default(now())
}

// 노무
model Labor {
  id          String   @id @default(cuid())
  logId       String
  log         DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  workerId    String?  // 근로자 마스터(Worker) 연결 외래키 (동명이인 구분 및 마스터 연동)
  worker      Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  name        String   // 노무자 이름
  jobType     String   // 공종
  unitPrice   Int      // 단가
  amount      Float    // 투입공수
  totalPrice  Int      // 총 금액
  note        String?  // 비고
  createdBy   String?  // 작성자 이름 기록

  @@index([logId])
  @@index([workerId])
  @@index([name])
}

// 장비 마스터 (건설기계 및 차량 정보 + 조종원)
model EquipmentMaster {
  id             String              @id @default(cuid())
  name           String              // 장비명/차종 (굴착기, 덤프트럭 등)
  spec           String?             // 규격 또는 차량번호 (06가1234 등)
  ownerType      String              @default("SUBCONTRACT") // DIRECT(원청 직영) / SUBCONTRACT(당사 투입)
  driverName     String?             // 조종원 성명
  driverPhone    String?             // 조종원 연락처
  unitPrice      Int                 @default(0) // 기본 단가
  documentStatus String              @default("UNKNOWN") // UNKNOWN, INCOMPLETE, COMPLETE, REVIEW
  documentUrl    String?             // 대표 서류 URL
  note           String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  documents      EquipmentDocument[]
  equipments     Equipment[]

  @@index([name])
  @@index([spec])
}

// 장비 관련 안전서류 (차량등록증, 배상책임보험증권, 조종사면허증 등)
model EquipmentDocument {
  id             String           @id @default(cuid())
  equipmentId    String?
  equipment      EquipmentMaster? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  documentType   String           // REGISTRATION(등록증), INSURANCE(보험), LICENSE(면허증), OTHER
  fileUrl        String
  extractedData  Json?
  status         String           @default("REVIEW") // SUCCESS, REVIEW, FAILED
  note           String?
  processedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([equipmentId])
  @@index([status])
}

// 장비
model Equipment {
  id             String           @id @default(cuid())
  logId          String
  log            DailyLog         @relation(fields: [logId], references: [id], onDelete: Cascade)
  equipmentMasterId String?       // 장비 마스터 연결 외래키
  master         EquipmentMaster? @relation(fields: [equipmentMasterId], references: [id], onDelete: SetNull)
  name           String           // 장비명
  spec           String?          // 규격
  unitPrice      Int              // 단가
  amount         Float            // 투입시간/일
  totalPrice     Int              // 총 금액
  note           String?
  createdBy      String?
  ownerType      String           @default("SUBCONTRACT") // DIRECT(원청 직영) / SUBCONTRACT(당사 투입) — 원가·기성 집계 시 구분
  taskDescription String?         // 작업내용 (예: 터파기, 되메우기, 자재 운반 등)
  documentStatus String           @default("UNKNOWN") // UNKNOWN/INCOMPLETE/COMPLETE/REVIEW — 장비 안전서류 충족여부
  documentUrl    String?          // 안전서류(보험, 장비등록증 등) 첨부 링크
  expenses       Expense[]        // 이 장비에 연결된 지출(주유비 등)

  @@index([logId])
  @@index([equipmentMasterId])
}

// 자재
model Material {
  id          String   @id @default(cuid())
  logId       String
  log         DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  name        String   // 자재명
  spec        String?  // 규격
  unit        String   // 단위
  quantity    Float    // 수량
  unitPrice   Int?     // 단가 (원가 집계에 필요)
  totalPrice  Int?     // 총 금액 (수량*단가, 캐시)
  invoiceUrl  String?  // 거래명세서/송장 첨부 링크
  note        String?
  createdBy   String?
}

// 경비
model Expense {
  id          String   @id @default(cuid())
  logId       String
  log         DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  category    String   // 항목 (주유비, 식대, 숙박비 등)
  amount      Int      // 금액
  note        String?  // 비고
  createdBy   String?
  assignedTo  String?    // 정산 담당자
  isSettled   Boolean   @default(false)  // 정산 완료 여부
  settledAt   DateTime?  // 정산 시각
  equipmentId String?    // 특정 장비에 연결(주유비 등 원가 추적용, 선택)
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
}

// 외주
model Outsourcing {
  id          String   @id @default(cuid())
  logId       String
  log         DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  companyName String   // 외주업체명
  task        String   // 작업내용
  amount      Int      // 기성/투입 금액
  note        String?
  createdBy   String?
}

// 웹 푸시 구독
model PushSub {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  userName  String?
  createdAt DateTime @default(now())
}

model WorkerDocument {
  id             String   @id @default(cuid())
  workerId       String?
  worker         Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  workerName     String?
  birthYYMMDD    String?
  documentType   String   // ID_CARD/BANKBOOK/SAFETY_EDU/OTHER
  driveFileId    String?
  driveFileUrl   String?
  driveFolderUrl String?
  sourceFileName String?
  extractedData  Json?
  confidence     Float?
  status         String   @default("REVIEW") // SUCCESS/REVIEW/FAILED
  note           String?
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workerId])
  @@index([workerName, birthYYMMDD])
  @@index([status])
}

model DriveSyncJob {
  id          String    @id @default(cuid())
  type        String    // WORKER_MASTER_IMPORT/DOCUMENT_SCAN/BILLING_EXPORT
  status      String    @default("PENDING") // PENDING/RUNNING/SUCCESS/FAILED
  sourceUrl   String?
  targetUrl   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  result      Json?
  error       String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status])
}

model MonthlyBilling {
  id                 String   @id @default(cuid())
  siteId             String
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  totalLaborCost     Float    @default(0)
  totalLaborAmount   Float    @default(0)
  workerCount        Int      @default(0)
  readyWorkerCount   Int      @default(0)
  holdWorkerCount    Int      @default(0)
  sheetUrl           String?
  pdfUrl             String?
  status             String   @default("DRAFT") // DRAFT/EXPORTED/CONFIRMED
  summary            Json?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([siteId, year, month])
  @@index([year, month])
}

// ============================================================
// 기성(도급 청구) 관리 — 견적내역서(BOQ)를 그대로 이식해 품목별로
// 매일 시공수량을 기록하고, 월말에 자동으로 기성청구액을 산출한다.
// "원가관리(Labor/Equipment/Material/Expense/Outsourcing)"와는
// 완전히 별개의 축이며, 두 축을 비교해 손익을 계산한다.
// ============================================================

// 계약(견적)내역서 품목 — 트리 구조로 원본 내역서 계층을 그대로 반영
model ContractItem {
  id                String         @id @default(cuid())
  siteId            String
  site              Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            ContractItem?  @relation("ContractItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          ContractItem[] @relation("ContractItemTree")
  code              String?        // 내역서 구분 코드 (예: "3.1.1") — 참고용, 고유값 아님(협상 중 분할될 수 있음)
  name              String         // 항목명
  spec              String?        // 규격
  unit              String?        // 단위 (그룹 소계 행은 null)
  isLeaf            Boolean        @default(true) // true=실제 시공수량을 입력하는 최종 품목, false=소계용 그룹 헤더
  contractQuantity  Float?         // 계약(견적)수량
  contractUnitPrice Int?           // 계약(견적)단가
  contractAmount    Float          @default(0) // 계약금액 (수량*단가, 캐시 — 그룹 헤더는 하위 합산). 대형 현장 총액이 INT4 범위(약 21억)를 넘어 Float 사용
  category          String?        // 내역서 "비고" 태그 (우수/오수/토공 등 대분류 필터용)
  sortOrder         Int            @default(0) // 원본 내역서 행 순서 보존(트리 렌더링용)
  isActive          Boolean        @default(true) // 계약 변경으로 폐기된 품목 소프트 삭제용
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  workQuantities    WorkQuantity[]

  @@index([siteId, sortOrder])
  @@index([siteId, isLeaf])
  @@index([parentId])
}

// 일일 시공수량 — "오늘 이 품목을 얼마나 시공했는지"의 원천 데이터
model WorkQuantity {
  id             String       @id @default(cuid())
  logId          String
  log            DailyLog     @relation(fields: [logId], references: [id], onDelete: Cascade)
  contractItemId String
  contractItem   ContractItem @relation(fields: [contractItemId], references: [id])
  quantity       Float        // 오늘 시공수량
  note           String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([contractItemId])
  @@index([logId])
}

// 월별 기성청구 스냅샷 — WorkQuantity를 월 단위로 집계해 확정한 결과
model MonthlyProgressClaim {
  id                    String    @id @default(cuid())
  siteId                String
  site                  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  year                  Int
  month                 Int
  totalClaimAmount      Float     @default(0) // 이번달 기성청구액 (전월 누적 대비 증가분)
  cumulativeClaimAmount Float     @default(0) // 이번달까지 누적 기성고 — 계약총액 근처까지 커질 수 있어 Float 사용
  totalCostAmount       Float     @default(0) // 이번달 실투입원가 (노무+장비+자재+경비+외주, 참고용 캐시)
  profitAmount          Float     @default(0) // 이번달 손익 = totalClaimAmount - totalCostAmount
  cumulativeCostAmount  Float     @default(0) // 착공~이번달까지 누적 실투입원가
  cumulativeProfitAmount Float    @default(0) // 누계손익 = cumulativeClaimAmount - cumulativeCostAmount
  status                String    @default("DRAFT") // DRAFT(작성중)/SUBMITTED(원청 제출)/CONFIRMED(지급 확정)
  submittedAt           DateTime?
  confirmedAt           DateTime?
  note                  String?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([siteId, year, month])
  @@index([siteId, year, month])
}

// 기성고 대비 잉여/부족 정산 기록 — 계약총액과 누적기성 사이의 조정 내역을 별도로 남긴다
model BillingAdjustment {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  type      String   // SURPLUS(잉여) / SHORTFALL(부족)
  amount    Int
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([siteId, date])
}

// 앱 개선 요청/버그 리포트 — 초기 운영 단계에서 사용자가 바로 남기는 피드백 게시판
model Feedback {
  id        String    @id @default(cuid())
  content   String
  category  String    @default("REQUEST") // REQUEST(요구사항) / BUG(버그) / ETC(기타)
  status    String    @default("OPEN") // OPEN(대기) / IN_PROGRESS(진행중) / DONE(완료)
  createdBy String?
  createdAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}
